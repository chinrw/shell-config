+package _115_open
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	sdk "github.com/OpenListTeam/115-sdk-go"
+	"golang.org/x/time/rate"
+)
+
+// Absence from a changing page list does not establish a terminal state.
+var ErrOfflineTaskNotVisible = errors.New("115 offline task is not currently visible")
+
+const offlinePollInterval = 3 * time.Second
+
+type offlinePage struct {
+	response *sdk.OfflineTaskListResp
+	err      error
+	expires  time.Time
+}
+
+// One cursor and page index per storage. Poll known hashes on their last page.
+// Unknown hashes share page 1 and at most one additional discovery page per interval.
+type offlineLookup struct {
+	client        *sdk.Client
+	gate          chan struct{}
+	fetch         func(context.Context, int64) (*sdk.OfflineTaskListResp, error)
+	now           func() time.Time
+	pages         map[int]offlinePage
+	pageOf        map[string]int
+	next          int
+	discoverAfter time.Time
+	discoveryErr  error
+}
+
+// Keep the page cache and its requests on the same account when a mount is reinitialized.
+func storageOfflineLookup(client *sdk.Client, limiter *rate.Limiter) *offlineLookup {
+	l := newOfflineLookup(func(ctx context.Context, page int64) (*sdk.OfflineTaskListResp, error) {
+		if limiter != nil {
+			if err := limiter.Wait(ctx); err != nil {
+				return nil, err
+			}
+		}
+		return client.OfflineTaskList(ctx, page)
+	})
+	l.client = client
+	return l
+}
+
+func newOfflineLookup(fetch func(context.Context, int64) (*sdk.OfflineTaskListResp, error)) *offlineLookup {
+	return &offlineLookup{
+		gate: make(chan struct{}, 1), fetch: fetch, now: time.Now,
+		pages: make(map[int]offlinePage), pageOf: make(map[string]int), next: 2,
+	}
+}
+
+func (l *offlineLookup) discard(page int) {
+	if old := l.pages[page].response; old != nil {
+		for _, task := range old.Tasks {
+			key := strings.ToLower(task.InfoHash)
+			if l.pageOf[key] == page {
+				delete(l.pageOf, key)
+			}
+		}
+	}
+	delete(l.pages, page)
+}
+
+func validOfflinePage(p *sdk.OfflineTaskListResp, page int) bool {
+	if p == nil || p.Page != page {
+		return false
+	}
+	if len(p.Tasks) == 0 {
+		return page == 1 && p.Count == 0 && (p.PageCount == 0 || p.PageCount == 1)
+	}
+	return page <= p.PageCount
+}
+
+func (l *offlineLookup) load(ctx context.Context, page int) (*sdk.OfflineTaskListResp, error) {
+	cached := l.pages[page]
+	if l.now().Before(cached.expires) {
+		if cached.err != nil {
+			return nil, cached.err
+		}
+		return cached.response, nil
+	}
+	response, err := l.fetch(ctx, int64(page))
+	if ctx.Err() != nil {
+		return nil, ctx.Err()
+	}
+	if err == nil && !validOfflinePage(response, page) {
+		err = fmt.Errorf("115 returned an incomplete offline task page %d", page)
+	}
+	expires := l.now().Add(offlinePollInterval)
+	if err != nil {
+		// Keep the last page hint for retries, but never serve its stale task on error.
+		cached.err, cached.expires = err, expires
+		l.pages[page] = cached
+		return nil, err
+	}
+	if page == 1 && cached.response != nil && response.PageCount < cached.response.PageCount {
+		for old := range l.pages {
+			if old > response.PageCount {
+				l.discard(old)
+			}
+		}
+	}
+	l.discard(page)
+	l.pages[page] = offlinePage{response: response, expires: expires}
+	for _, task := range response.Tasks {
+		l.pageOf[strings.ToLower(task.InfoHash)] = page
+	}
+	return response, nil
+}
+
+func findOfflineTask(response *sdk.OfflineTaskListResp, hash string) *sdk.OfflineTask {
+	for i := range response.Tasks {
+		if strings.EqualFold(response.Tasks[i].InfoHash, hash) {
+			return &response.Tasks[i]
+		}
+	}
+	return nil
+}
+
+func (l *offlineLookup) lookup(ctx context.Context, hash string) (*sdk.OfflineTask, error) {
+	select {
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	case l.gate <- struct{}{}:
+	}
+	defer func() { <-l.gate }()
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	key := strings.ToLower(hash)
+	first, err := l.load(ctx, 1)
+	if err != nil {
+		return nil, err
+	}
+	if task := findOfflineTask(first, key); task != nil {
+		return task, nil
+	}
+	if page := l.pageOf[key]; page > 1 && page <= first.PageCount {
+		response, err := l.load(ctx, page)
+		if err != nil {
+			return nil, err
+		}
+		if task := findOfflineTask(response, key); task != nil {
+			return task, nil
+		}
+	}
+	if first.PageCount < 2 {
+		return nil, ErrOfflineTaskNotVisible
+	}
+	if l.now().Before(l.discoverAfter) {
+		if l.discoveryErr != nil {
+			return nil, l.discoveryErr
+		}
+		return nil, ErrOfflineTaskNotVisible
+	}
+	if l.next > first.PageCount {
+		l.next = 2
+	}
+	page := l.next
+	response, err := l.load(ctx, page)
+	if ctx.Err() != nil {
+		return nil, ctx.Err()
+	}
+	l.discoverAfter = l.now().Add(offlinePollInterval)
+	l.discoveryErr = err
+	if err != nil {
+		return nil, err
+	}
+	l.next++
+	if l.pageOf[key] == page {
+		if task := findOfflineTask(response, key); task != nil {
+			return task, nil
+		}
+	}
+	return nil, ErrOfflineTaskNotVisible
+}
+
+// A new submission of the same hash must not inherit a cached completion.
+func (l *offlineLookup) invalidate(hashes []string) {
+	l.gate <- struct{}{}
+	defer func() { <-l.gate }()
+	for _, hash := range hashes {
+		if page := l.pageOf[strings.ToLower(hash)]; page != 0 {
+			l.discard(page)
+		}
+	}
+	l.discard(1)
+}
