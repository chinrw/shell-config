+// Recoverable runs before the manager resets a running task to pending.
+// Older 115 Open receipts kept the magnet but not the accepted infohash.
+func (t *DownloadTask) Recoverable() bool {
+	if t.Toolname != "115 Open" || t.GetState() != tache.StateRunning || t.Open115GID != "" {
+		return true
+	}
+	magnet, err := url.Parse(t.Url)
+	if err != nil || magnet.Scheme != "magnet" {
+		return false
+	}
+	for _, xt := range magnet.Query()["xt"] {
+		hash, ok := strings.CutPrefix(strings.ToLower(xt), "urn:btih:")
+		if !ok {
+			continue
+		}
+		if raw, err := hex.DecodeString(hash); err == nil && len(raw) == 20 {
+			t.Open115GID = hash
+			return true
+		}
+		if raw, err := base32.StdEncoding.DecodeString(strings.ToUpper(hash)); err == nil && len(raw) == 20 {
+			t.Open115GID = hex.EncodeToString(raw)
+			return true
+		}
+	}
+	return false
+}
