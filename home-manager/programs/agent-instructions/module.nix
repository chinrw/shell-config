{
  config,
  lib,
  pkgs,
  hostname,
  ...
}:
let
  instructions = import ./. { inherit lib pkgs; };
in
{
  home.activation.sharedAgentInstructions = lib.hm.dag.entryAfter [ "writeBoundary" ] (
    instructions.assemble {
      tool = "Shared";
      directory = "${config.home.homeDirectory}/.agents";
      filename = "AGENTS.md";
      localFilename = "AGENTS.local.md";
      inherit hostname;
      sharedFile = instructions.file;
      baseText = ''
        <!-- Generated by home-manager from shell-config/home-manager/programs/agent-instructions/.
             Edits here are lost on the next switch. Host-local rules go in
             ~/.agents/AGENTS.local.md. -->

        # User-scope Agent Instructions

      '';
    }
  );
}
