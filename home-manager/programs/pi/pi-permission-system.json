{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "yoloMode": false,
  "commandEffects": {
    "git": {
      "unlessOption": ["--output"],
      "subcommands": {
        "log": "read",
        "show": "read",
        "status": "read",
        "diff": "read",
        "blame": "read",
        "ls-files": "read",
        "remote": {
          "subcommands": {
            "show": "read"
          }
        }
      }
    }
  },
  "permission": {
    "*": "allow",
    "path": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg": "deny",
      "~/.gnupg/*": "deny",
      "~/.config/sops": "deny",
      "~/.config/sops/*": "deny",
      "~/.config/sops-nix": "deny",
      "~/.config/sops-nix/*": "deny",
      "/run/secrets": "deny",
      "/run/secrets/*": "deny",
      "/run/secrets.d": "deny",
      "/run/secrets.d/*": "deny",
      "/run/user/*/secrets": "deny",
      "/run/user/*/secrets/*": "deny",
      "/run/user/*/secrets.d": "deny",
      "/run/user/*/secrets.d/*": "deny",
      "/var/folders/*/secrets": "deny",
      "/var/folders/*/secrets/*": "deny",
      "/var/folders/*/secrets.d": "deny",
      "/var/folders/*/secrets.d/*": "deny",
      "/private/var/folders/*/secrets": "deny",
      "/private/var/folders/*/secrets/*": "deny",
      "/private/var/folders/*/secrets.d": "deny",
      "/private/var/folders/*/secrets.d/*": "deny",
      "~/.config/op": "deny",
      "~/.config/op/*": "deny",
      "~/.aws": "deny",
      "~/.aws/*": "deny",
      "~/.kube": "deny",
      "~/.kube/*": "deny",
      "~/.docker/config.json": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.config/rclone": "deny",
      "~/.config/rclone/*": "deny",
      "~/.config/cachix/cachix.dhall": "deny",
      "~/.git-credentials": "deny",
      "~/.netrc": "deny",
      "~/.npmrc": "deny",
      "~/.pypirc": "deny",
      "~/.pi/agent/auth.json": "deny",
      "~/.pi/agent/mcp-oauth": "deny",
      "~/.pi/agent/mcp-oauth/*": "deny",
      "~/.codex/auth.json": "deny",
      "~/.claude/.credentials.json": "deny",
      "/etc/shadow": "deny",
      "/etc/gshadow": "deny",
      "/etc/sudoers": "deny",
      "/etc/sudoers.d": "deny",
      "/etc/sudoers.d/*": "deny",
      "~/Library/Keychains": "deny",
      "~/Library/Keychains/*": "deny"
    },
    "external_directory_write": {
      "*": "ask",
      "/tmp/*": "allow",
      "/private/tmp/*": "allow"
    },
    "bash": {
      "*": "allow",
      "rm -rf *": "ask",
      "rm -fr *": "ask",
      "sudo *": "ask",
      "git *": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git blame *": "allow",
      "git ls-files *": "allow",
      "git rev-parse *": "allow",
      "git merge-base *": "allow",
      "git describe *": "allow",
      "git shortlog *": "allow",
      "git cat-file *": "allow",
      "git branch": "allow",
      "git branch --list*": "allow",
      "git branch --show-current": "allow",
      "git tag": "allow",
      "git tag -l*": "allow",
      "git tag --list*": "allow",
      "git remote -v": "allow",
      "git remote show *": "allow",
      "git * --output*": "ask"
    }
  }
}
