{
  config,
  lib,
  pkgs,
  ...
}:
let
  seedSettings = {
    theme = "tomorrow-night";
    defaultThinkingLevel = "high";
    steeringMode = "one-at-a-time";
    hideThinkingBlock = true;
    subagents.agentOverrides = {
      context-builder.model = "";
      planner.model = "";
      researcher.model = "";
      reviewer.model = "";
      scout.model = "";
      worker.model = "";
    };
    treeFilterMode = "default";
    terminal.showTerminalProgress = true;
    transport = "auto";
    quietStartup = true;
    compaction.enabled = true;
    fullscreenScrollbar = "auto";
    tuiMode = "regular";
  };
  extensionSettings = import ./extension-settings.nix;
  sharedAgentInstructions = import ../agent-instructions { inherit lib pkgs; };
  banner = ''
    <!-- Generated by home-manager from shell-config/home-manager/programs/pi/.
         Edit the Nix source instead of this file. -->
  '';
in
{
  programs.pi-coding-agent = {
    enable = true;
    mutableSettings = true;
    settings.packages = [
      "npm:pi-ask-user"
      "npm:pi-web-access"
      "npm:pi-add-dir"
      "npm:pi-claude-cli"
      "npm:@plannotator/pi-extension"
      "npm:pi-slopchop"
      "npm:@tmustier/pi-usage-extension"
      "npm:pi-btw"
      "npm:pi-interactive-shell"
      "git:github.com/davebcn87/pi-autoresearch"
      "npm:@tmustier/pi-ralph-wiggum"
      "npm:@victor-software-house/pi-curated-themes"
      "npm:pi-cc-extensions"
      "npm:@tintinweb/pi-subagents"
      "npm:@tintinweb/pi-tasks"
      "npm:@ff-labs/pi-fff"
      "npm:@gotgenes/pi-permission-system"
      "npm:@ayulab/pi-rewind"
      "npm:@narumitw/pi-retry"
      "npm:@narumitw/pi-lsp"
      "npm:pi-background-tasks"
      "npm:pi-zentui"
      "npm:@gamaraan/next-prompt"
      "npm:@czottmann/pi-automode"
      "npm:context-mode"
      "npm:@quintinshaw/pi-dynamic-workflows"
      "npm:pi-commandcode-provider"
      "npm:@diegopetrucci/pi-fast"
    ];
    extraPackages = with pkgs; [
      nodejs
      bun
      nixd
      ruff
      vtsls
    ];

    context = banner + "\n# User-scope Pi Configuration\n\n" + sharedAgentInstructions.text;

    keybindings = {
      "tui.editor.cursorUp" = [
        "up"
        "ctrl+p"
      ];
      "tui.editor.cursorDown" = [
        "down"
        "ctrl+n"
      ];
      # ctrl+p stays bound to app.model.cycleForward by default; app actions
      # are matched before editor bindings, so move model cycling to alt+p.
      "app.model.cycleForward" = [ "alt+p" ];
      "tui.select.up" = [
        "up"
        "ctrl+p"
      ];
      "tui.select.down" = [
        "down"
        "ctrl+n"
      ];
      # Moved off ctrl+p/ctrl+n so they don't shadow tui.select.* in selectors.
      "app.session.togglePath" = [ "alt+shift+p" ];
      "app.session.toggleNamedFilter" = [ "alt+n" ];
      "app.models.toggleProvider" = [ "alt+shift+t" ];
    };
  };

  # Seed preferences without resetting choices saved by Pi or its extensions.
  home.activation.piPreferences = lib.hm.dag.entryAfter [ "piCodingAgentMutableSettings" ] (
    lib.concatStringsSep "\n" (
      lib.mapAttrsToList (
        name: defaults:
        lib.hm.generators.mkImpureConfigMerger {
          inherit pkgs;
          format = "json";
          empty = "{}";
          mode = "600";
          path = "${config.programs.pi-coding-agent.configDir}/${name}";
          staticSettings = pkgs.writeText "pi-${builtins.baseNameOf name}" (builtins.toJSON defaults);
          jqOperation = "$static * $dynamic";
        }
      ) (extensionSettings // { "settings.json" = seedSettings; })
    )
  );

  # Server catalog for @narumitw/pi-lsp. Replaces the built-in catalog
  home.file.".pi/agent/pi-lsp.json".source = ./pi-lsp.json;

  # pi-interactive-shell spawn shortcut. Default alt+shift+p collides with our
  # app.session.togglePath binding; move the extension onto a free key.
  home.file.".pi/agent/interactive-shell.json".text = builtins.toJSON {
    spawn.shortcut = "alt+i";
  };

  # Pi reserves ctrl+shift+f for fullscreen transcript search.
  home.file.".pi/agent/extensions/pi-autoresearch.json".text = builtins.toJSON {
    shortcuts.fullscreenDashboard = "ctrl+shift+y";
  };
}
